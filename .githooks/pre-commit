#!/usr/bin/env bash
# Auto-syncs the pinned SHA-256 hashes in install/Install-SwiftSlate.ps1 whenever
# SwiftSlate.pyw, commands.json, or assets/icon.ico changes.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

installer="install/Install-SwiftSlate.ps1"
if [ ! -f "$installer" ]; then
  exit 0
fi

updated=$(python3 - <<'PY'
import hashlib, pathlib, re, sys

installer_path = pathlib.Path("install/Install-SwiftSlate.ps1")
content = installer_path.read_text(encoding="utf-8")
changed = False

for rel in ("SwiftSlate.pyw", "commands.json", "assets/icon.ico"):
    p = pathlib.Path(rel)
    if not p.is_file():
        print(f"pre-commit: missing {rel}", file=sys.stderr)
        sys.exit(1)
    actual = hashlib.sha256(p.read_bytes()).hexdigest().upper()
    pattern = re.compile(r'("' + re.escape(rel) + r'"\s*=\s*")([0-9A-Fa-f]{64})(")')
    m = pattern.search(content)
    if not m:
        print(f"pre-commit: could not find pin for {rel} in {installer_path}", file=sys.stderr)
        sys.exit(1)
    if m.group(2).upper() != actual:
        content = pattern.sub(rf'\g<1>{actual}\g<3>', content, count=1)
        print(f"pre-commit: updated {installer_path} pin for {rel}")
        changed = True

if changed:
    installer_path.write_text(content, encoding="utf-8")
print("1" if changed else "0")
PY
)

if [ "$updated" = "1" ]; then
  git add "$installer"
fi
exit 0
